<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.Insets?>
<?import javafx.scene.control.Button?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.layout.GridPane?>
<?import javafx.scene.layout.VBox?>

<VBox alignment="CENTER" spacing="12"
      prefWidth="320"
      prefHeight="420"
      xmlns:fx="http://javafx.com/fxml"
      fx:controller="org.openjfx.calculator.CalculatorController">

    <padding>
        <Insets bottom="16" left="16" right="16" top="16"/>
    </padding>

    <Label fx:id="display"
           text="0"
           maxWidth="Infinity"
           alignment="CENTER_RIGHT"
           style="-fx-font-size: 32px;"
    />
    <GridPane hgap="8" vgap="8">
        <Button text="C"
                onAction="#onClearClick"
                GridPane.columnIndex="0" GridPane.rowIndex="0"/>
        <Button text="±"
                onAction="#onSignChangeClick"
                GridPane.columnIndex="1" GridPane.rowIndex="0"/>
        <Button text="\%" GridPane.columnIndex="2" GridPane.rowIndex="0"/>
        <Button text="/"
                onAction="#onOperatorClick"
                GridPane.columnIndex="3" GridPane.rowIndex="0"/>

        <Button text="7"
                onAction="#onDigitClick"
                GridPane.columnIndex="0" GridPane.rowIndex="1"
        />
        <Button text="8"
                onAction="#onDigitClick"
                GridPane.columnIndex="1" GridPane.rowIndex="1"/>
        <Button text="9"
                onAction="#onDigitClick"
                GridPane.columnIndex="2" GridPane.rowIndex="1"/>
        <Button text="x" GridPane.columnIndex="3" GridPane.rowIndex="1"/>

        <Button text="4"
                onAction="#onDigitClick"
                GridPane.columnIndex="0" GridPane.rowIndex="2"/>
        <Button text="5"
                onAction="#onDigitClick"
                GridPane.columnIndex="1" GridPane.rowIndex="2"/>
        <Button text="6"
                onAction="#onDigitClick"
                GridPane.columnIndex="2" GridPane.rowIndex="2"/>
        <Button text="−"
                onAction="#onOperatorClick"
                GridPane.columnIndex="3" GridPane.rowIndex="2"/>

        <Button text="1"
                onAction="#onDigitClick"
                GridPane.columnIndex="0" GridPane.rowIndex="3"/>
        <Button text="2"
                onAction="#onDigitClick"
                GridPane.columnIndex="1" GridPane.rowIndex="3"/>
        <Button text="3"
                onAction="#onDigitClick"
                GridPane.columnIndex="2" GridPane.rowIndex="3"/>
        <Button text="+"
                onAction="#onOperatorClick"
                GridPane.columnIndex="3" GridPane.rowIndex="3"/>

        <Button text="0"
                onAction="#onDigitClick"
                GridPane.columnIndex="0" GridPane.rowIndex="4"/>
        <Button text=","
                onAction="#onDecimalClick"
                GridPane.columnIndex="1" GridPane.rowIndex="4"/>
        <Button text="="
                onAction="#onEqualsClick"
                GridPane.columnIndex="2" GridPane.rowIndex="4"
                GridPane.columnSpan="2" maxWidth="Infinity"/>
    </GridPane>
</VBox>
